{
  "grpcSettings": {
    "idle_timeout": 60,
    "health_check_timeout": 20,
    "permit_without_stream": false,
    "initial_windows_size": 0
  },
  "tcpSettings": {
    "header": {
      "type": "none"
    }
  },
  "tcphttpSettings": {
    "header": {
      "request": {
        "headers": {
          "Accept-Encoding": [
            "gzip",
            "deflate"
          ],
          "Connection": [
            "keep-alive"
          ],
          "Pragma": "no-cache"
        },
        "method": "GET",
        "version": "1.1"
      }
    }
  },
  "splithttpSettings": {
    "headers": {
      "Pragma": "no-cache"
    }
  }
}
